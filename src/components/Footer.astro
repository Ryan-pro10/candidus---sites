---
import { paraAba } from "../data/depoimentos.js";
// Rodapé. home: true na página inicial.
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = home ? "" : "/";
---
<footer>
  <div class="wrap">
    <div class="f-grid">
      <div class="f-brand">
        <img class="logo-foot" src="/assets/img/logo-footer.png" alt="Candidus — Gestão Financeira" width="760" height="473">
        <p>Organização financeira e controladoria para empresas que querem decidir com clareza e segurança.</p>
        <div class="socials">
          <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9V9Z"/></svg></a>
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="#" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.3-.4-4.9a2.6 2.6 0 0 0-1.8-1.8C19.2 5 12 5 12 5s-7.2 0-8.8.3A2.6 2.6 0 0 0 1.4 7.1C1 8.7 1 12 1 12s0 3.3.4 4.9a2.6 2.6 0 0 0 1.8 1.8C4.8 19 12 19 12 19s7.2 0 8.8-.3a2.6 2.6 0 0 0 1.8-1.8C23 15.3 23 12 23 12ZM10 15V9l5 3-5 3Z"/></svg></a>
        </div>
      </div>
      <div class="f-col">
        <h5>Serviços</h5>
        <a href="/servicos/contas-a-pagar/">Contas a pagar</a><a href="/servicos/contas-a-receber/">Contas a receber</a><a href="/servicos/conciliacao-bancaria/">Conciliação bancária</a><a href="/servicos/fluxo-de-caixa/">Fluxo de caixa</a><a href="/servicos/relatorios-gerenciais/">Relatórios gerenciais</a><a href="/servicos/indicadores-financeiros/">Indicadores financeiros</a>
      </div>
      <div class="f-col">
        <h5>Empresa</h5>
        <a href={`${base}#planos`}>Planos</a><a href={`${base}#sobre`}>Sobre nós</a>{paraAba.length > 0 && <a href="/depoimentos/">Depoimentos</a>}<a href={`${base}#como-funciona`}>Como funciona</a><a href={`${base}#contato`}>Contato</a>
      </div>
      <div class="f-col">
        <h5>Contato</h5>
        <a href="#" class="config">E-mail: a configurar</a>
        <a href="#" class="config">Telefone: a configurar</a>
        <a href="#" class="config">Endereço: a configurar</a>
        <a href="#" class="config">CNPJ: a configurar</a>
      </div>
    </div>
    <div class="f-bottom">
      <span>© <span id="year"></span> Candidus BPO Financeiro. Todos os direitos reservados.</span>
      <div class="f-legal"><a href="#">Política de Privacidade</a><a href="#">Termos de Uso</a></div>
    </div>
  </div>
</footer>
