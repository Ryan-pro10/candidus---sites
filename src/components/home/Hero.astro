---
---
<!-- ===================== HERO ===================== -->
<section class="hero" id="inicio">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow reveal">BPO Financeiro e Controladoria</span>
        <h1 class="reveal d1"><span class="l1">Seu financeiro em ordem.</span><br><span class="l2">Sua empresa no controle.</span></h1>
        <p class="lead reveal d2">Cuidamos das suas contas a pagar e receber, conciliação bancária, fluxo de caixa e relatórios gerenciais para você tomar decisões com mais clareza e segurança.</p>
        <div class="hero-cta reveal d3">
          <a href="#servicos" class="btn btn-primary">Conhecer nossos serviços <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="#contato" class="btn btn-ghost">Agendar uma conversa <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
        </div>
      </div>

      <!-- dashboard demo -->
      <div class="dash reveal d2" aria-label="Painel demonstrativo">
        <div class="dash-head">
          <div>
            <div class="dash-label">Saldo consolidado</div>
            <div class="dash-value" data-count="482230" data-prefix="R$ ">R$ 0</div>
            <div class="dash-delta"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17 9 11l4 4 8-8M15 4h6v6"/></svg> +6,0% em relação ao mês anterior</div>
          </div>
          <span class="dash-pill">Últimos 12 meses <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
        </div>
        <div class="chart">
          <svg id="heroChart" viewBox="0 0 560 150" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#55D6A7" stop-opacity=".32"/>
                <stop offset="1" stop-color="#55D6A7" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path id="chartArea" fill="url(#area)" d=""></path>
            <path id="chartLine" fill="none" stroke="#55D6A7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d=""></path>
            <circle id="chartDot" r="5" fill="#83F0C5" stroke="#08182B" stroke-width="2" opacity="0"></circle>
          </svg>
          <div class="grid-x"><span>Jan</span><span>Fev</span><span>Mar</span><span>Abr</span><span>Mai</span><span>Jun</span><span>Jul</span><span>Ago</span><span>Set</span><span>Out</span><span>Nov</span><span>Dez</span></div>
        </div>
        <div class="mini-cards">
          <div class="mini">
            <svg class="mi-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <div class="mi-k">Contas a receber</div><div class="mi-v">R$ 196.4k</div>
          </div>
          <div class="mini">
            <svg class="mi-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18M3 9l2-5h14l2 5M3 9v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9M9 14h6"/></svg>
            <div class="mi-k">Contas a pagar</div><div class="mi-v">R$ 148.2k</div>
          </div>
          <div class="mini">
            <svg class="mi-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M7 14l4-4 3 3 5-6"/></svg>
            <div class="mi-k">Fluxo de caixa</div><div class="mi-v">Positivo</div>
          </div>
        </div>
      </div>
    </div>

    <!-- trust strip -->
    <div class="trust reveal d3">
      <div class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg> Mais organização</div>
      <div class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.4 7.6 8 9 4.6-1.4 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg> Processos seguros</div>
      <div class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg> Parceria de longo prazo</div>
      <span class="tnote">clareza com propósito.</span>
    </div>
  </div>
</section>
