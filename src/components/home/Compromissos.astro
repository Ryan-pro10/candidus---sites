---
// Compromissos da Candidus (src/data/compromissos.js), no fim da seção "Por que a Candidus".
// Os depoimentos ficam numa seção própria, logo abaixo da imagem "Mais do que números" (Depoimentos.astro).
import { compromissos } from "../../data/compromissos.js";

const icones = {
  aprovar: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  banco: '<path d="M3 21h18"/><path d="M5 21V10"/><path d="M19 21V10"/><path d="M9 21V10"/><path d="M15 21V10"/><path d="M12 3 3 8h18z"/>',
  lgpd: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  relatorio: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/>',
};
---
<div class="commitments reveal" aria-labelledby="comp-titulo">
  <h3 id="comp-titulo">Nossos compromissos com a sua empresa</h3>
  <ul>
    {compromissos.map((c) => (
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones[c.icone]} />
        <span><strong>{c.titulo}</strong>{c.texto}</span>
      </li>
    ))}
  </ul>
</div>
