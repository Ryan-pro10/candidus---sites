---
// Estrutura comum a todas as páginas: <head>, header, rodapé e scripts.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  home?: boolean;      // página inicial
  active?: string;     // item ativo no menu
  form?: boolean;      // carrega o script do formulário
}
const { title, description, home = false, active, form = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#08182B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
</head>
<body>

<Header home={home} active={active} />

<slot />

<Footer home={home} />

<script is:inline src="/js/main.js"></script>
{form && <script is:inline src="/js/formulario.js"></script>}
</body>
</html>
